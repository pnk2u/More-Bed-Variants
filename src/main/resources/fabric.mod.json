{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"email": "contact@pnku.de",
		"homepage": "https://www.pnku.de/",
		"sources": "https://github.com/pnk2u/More-Bed-Variants",
		"issues": "https://github.com/pnk2u/More-Bed-Variants/issues"
	},
	"license": "${mod_license}",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.pnku.mbdv.MoreBedVariants"
		],
		"client": [
			"de.pnku.mbdv.MoreBedVariantsClient"
		]
	},
	"mixins": [
		{
			"environment": "client",
			"config": "quad-lolmbdv.client.mixins.json"
		},
		"quad-lolmbdv.mixins.json"
	],
	"accessWidener": "quad-lolmbdv.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">${minecraft_version_0} <${minecraft_version_1}",
		"java": ">=21",
		"fabric-api": ">=0.100.0"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.com/invite/sA42pp6cuX"
			}
		},
		"mc-publish": {
			"modrinth": "nKaiA11S",
			"curseforge": "1077380",
			"dependencies": [
				"fabric-api(required)#(ignore)"
			]
		}
	}
}